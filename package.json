{
  "name": "api-email",
  "version": "0.1.0",
  "description": "Official Node.js SDK for api.email: send and receive transactional email through one API.",
  "keywords": [
    "email",
    "email api",
    "transactional email",
    "send email",
    "inbound email",
    "email webhook",
    "api.email"
  ],
  "homepage": "https://api.email/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/api-email/api-email-node.git"
  },
  "bugs": "https://github.com/api-email/api-email-node/issues",
  "license": "MIT",
  "author": "APPS34 SARL <info@api.email>",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "lint:pkg": "publint && attw --pack .",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke.cjs",
    "check": "npm run typecheck && npm test && npm run build && npm run lint:pkg && npm run smoke",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "20.19.43",
    "publint": "0.3.25",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
